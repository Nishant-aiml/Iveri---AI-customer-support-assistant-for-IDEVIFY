# ==============================================================================
# Iveri AI Customer Support Assistant - Environment Configuration
# ==============================================================================

# Application Environment ('development' | 'production')
ENVIRONMENT=development

# Server Port
PORT=8000

# Security & Authentication (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=super-secret-jwt-key-replace-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite (Default, zero setup required):
DATABASE_URL=sqlite+aiosqlite:///./idevify.db
# Production PostgreSQL (e.g. Render / Neon / Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/idevify_db

# Primary Document Intelligence (Sarvam AI API)
# Get free key from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# Primary LLM & Embeddings (Google Gemini API - Generous Free Tier)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Fallback LLM (Groq Cloud API - 30 req/min Free Tier)
# Get key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Storage Paths
CHROMA_PERSIST_DIRECTORY=./chroma_db
UPLOAD_DIRECTORY=./uploads

# Hybrid RAG & Circuit-Breaker Tuning
CONFIDENCE_THRESHOLD=0.55
RRF_K=60
TOP_K_CHUNKS=4
