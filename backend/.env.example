# Environment Configuration
ENVIRONMENT=development
PORT=8000

# Database Configuration (SQLite for local dev, PostgreSQL for Render production)
DATABASE_URL=sqlite+aiosqlite:///./idevify.db
# For PostgreSQL on Render:
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/dbname

# JWT Security
JWT_SECRET=super-secret-jwt-key-change-in-production-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sarvam AI Document Intelligence API (Primary Parser)
SARVAM_API_KEY=

# Multi-Tier LLM APIs (Render Free-Tier 512MB RAM Safe)
# Tier 1 (Primary Freemium): Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tier 2 (Fallback Hosted): Groq LPUs
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional OpenAI (if preferred)
OPENAI_API_KEY=

# Vector Store Path
CHROMA_PERSIST_DIRECTORY=./chroma_db

# File Upload Directory
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=25

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
